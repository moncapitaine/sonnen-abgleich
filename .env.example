# Copy to .env and fill in. Used by compose.yml for running on one machine.

# Shown in the page header, e.g. the address of the house. Set the real one in .env only.
SITE_NAME="Musterstr. 1, Musterstadt"

# Login of the sonnen customer portal (my.sonnen.de). Leave empty to work with CSV imports only.
SONNEN_USERNAME=
SONNEN_PASSWORD=
# Only needed if the account has more than one installation
SONNEN_SITE_ID=

# Password for this web app. Set one before exposing the app to the internet.
APP_PASSWORD=

# Daily download time (house local time) and switch
SYNC_TIME=04:20
SYNC_ENABLED=1
