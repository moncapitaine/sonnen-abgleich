# Settings of one installation on a Docker Swarm (stack.yml). Copy to .env and fill in; ./setup.sh does the
# copying. The secrets are not here: they are files in ./secrets.
#
# deploy.sh loads this file with the shell (`source`): a value with spaces needs quotes, as below.

# The name of the stack. The service and the secrets carry it.
STACK_NAME=sonnen

# The public name of the app. Its DNS record points at the node that runs the edge proxy.
APP_HOST=sonnen.example.com

# The image to run: `build` builds this checkout on the node that runs it; or a pushed image.
IMAGE=build

# How the Docker CLI reaches a manager of the swarm, as an SSH host (ssh://<this>). Empty: the Docker this
# shell talks to already.
SWARM_MANAGER=

# Where the service runs and the data lives: DATA_NODE is the node, as an SSH host whose user may use Docker
# there, and DATA_DIR the folder on it. Empty DATA_NODE: the manager above.
DATA_DIR=/srv/sonnen
DATA_NODE=

# The network of the edge proxy (caddy-docker-proxy).
PROXY_NETWORK=caddy

# Shown under the title, and the time of the daily download (house local time).
SITE_NAME="Musterstr. 1, Musterstadt"
SYNC_TIME=04:20
